        "border": "#f2ede624",
        "border.variant": "#f2ede614",
        "border.focused": "#a11f31",
        "border.selected": "#a11f31",
        "border.transparent": "#f2ede600",
        "border.disabled": "#f2ede60f",

        // --- Elements (buttons, inputs) --------------------------------------
        "element.background": "#f2ede60f",
        "element.hover": "#f2ede61a",
        "element.active": "#f2ede624",
        "element.selected": "#a11f3140",
        "element.disabled": "#f2ede60f",
