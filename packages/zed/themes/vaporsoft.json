        // --- Diff hunks in the editor ----------------------------------------
        "editor.diff_hunk.added.background": "#2ea44f26",
        "editor.diff_hunk.added.hollow_background": "#2ea44f14",
        "editor.diff_hunk.added.hollow_border": "#2ea44f",
        "editor.diff_hunk.deleted.background": "#a11f3133",
        "editor.diff_hunk.deleted.hollow_background": "#a11f3126",
        "editor.diff_hunk.deleted.hollow_border": "#a11f31",

