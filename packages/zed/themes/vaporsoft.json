        // --- Players (carmine is always the local user) ----------------------
        "players": [
          { "cursor": "#a11f31", "background": "#a11f31", "selection": "#a11f314d" },
          { "cursor": "#c3777e", "background": "#c3777e", "selection": "#c3777e40" },
          { "cursor": "#d39ea1", "background": "#d39ea1", "selection": "#d39ea140" },
          { "cursor": "#e2c6c3", "background": "#e2c6c3", "selection": "#e2c6c340" },
          { "cursor": "#b44f5b", "background": "#b44f5b", "selection": "#b44f5b40" },
          { "cursor": "#f2ede6", "background": "#f2ede6", "selection": "#f2ede633" },
          { "cursor": "#801c2b", "background": "#801c2b", "selection": "#801c2b66" },
          { "cursor": "#641a26", "background": "#641a26", "selection": "#641a2680" }
        ],

        // --- Syntax ----------------------------------------------------------
        // Tiers: keyword #c3777e | function #e2c6c3 | type + string #d39ea1
        //        constant #c3777e | text #f2ede6 | punctuation, comment = alpha
        "syntax": {
          // Comments
          "comment": { "color": "#f2ede680", "font_style": "italic" },
          "comment.doc": { "color": "#f2ede699", "font_style": "italic" },

          // Keywords and preprocessor
          "keyword": { "color": "#c3777e" },
          "preproc": { "color": "#c3777e" },
          "attribute": { "color": "#d39ea1" },

          // Functions
          "function": { "color": "#e2c6c3" },
          "constructor": { "color": "#e2c6c3" },

          // Types
          "type": { "color": "#d39ea1" },
          "type.builtin": { "color": "#d39ea1" },
          "enum": { "color": "#d39ea1" },
          "variant": { "color": "#d39ea1" },
          "label": { "color": "#d39ea1" },

          // Variables and properties
          "variable": { "color": "#f2ede6" },
          "variable.parameter": { "color": "#f2ede6" },
          "variable.special": { "color": "#c3777e", "font_style": "italic" },
          "property": { "color": "#f2ede6" },
          "primary": { "color": "#f2ede6" },
          "embedded": { "color": "#f2ede6" },

          // Literals
          "string": { "color": "#d39ea1" },
          "string.escape": { "color": "#e2c6c3" },
          "string.regex": { "color": "#e2c6c3" },
          "string.special": { "color": "#e2c6c3" },
          "string.special.symbol": { "color": "#e2c6c3" },
          "number": { "color": "#c3777e" },
          "boolean": { "color": "#c3777e" },
          "constant": { "color": "#c3777e" },
          "constant.builtin": { "color": "#c3777e" },

          // Operators and punctuation
          "operator": { "color": "#f2ede6c7" },
          "punctuation": { "color": "#f2ede699" },
          "punctuation.bracket": { "color": "#f2ede6c7" },
          "punctuation.delimiter": { "color": "#f2ede699" },
          "punctuation.list_marker": { "color": "#c3777e" },
          "punctuation.markup": { "color": "#c3777e" },
          "punctuation.special": { "color": "#c3777e" },

          // Markup and web
          "tag": { "color": "#c3777e" },
          "tag.doctype": { "color": "#c3777e" },
          "selector": { "color": "#d39ea1" },
          "selector.pseudo": { "color": "#c3777e" },
          "title": { "color": "#c3777e", "font_weight": 700 },
          "emphasis": { "color": "#f2ede6", "font_style": "italic" },
          "emphasis.strong": { "color": "#f2ede6", "font_weight": 700 },
          "link_text": { "color": "#c3777e" },
          "link_uri": { "color": "#d39ea1" },
          "text.literal": { "color": "#d39ea1" },

          // Editor-provided
          "hint": { "color": "#f2ede699" },
          "predictive": { "color": "#f2ede680", "font_style": "italic" }
        }
      }
    },

