// =============================================================================
// VAPORSOFT for Zed  |  theme family v1.0.0  |  JSONC (Zed accepts comments)
// Source of truth: ../../../palette.json. Every colour below is a palette value,
// optionally with an alpha suffix. Nothing is invented. Run scripts/check-theme.mjs.
//
// PALETTE KEY
//   carmine  #a11f31  the only accent. Exact, never approximated.
//   ink      #07080b  dark ground          paper    #f2ede6  light ground / dark text
//   graphite #121318  light text / rules   surface  #f4efe8  light surface
//   ramp     shades #801c2b #641a26 #491822 #2d151d   (read on LIGHT grounds)
//            tints  #b44f5b #c3777e #d39ea1 #e2c6c3   (read on DARK grounds)
//   live     #2ea44f  functional signal only (success / added). Never decorative.
//
// RULES
//   1. Carmine exact for strokes, fills, caret, focus, selection. Never for dark-theme text
//      (2.6:1 on ink). Text on dark uses tints; text on light uses carmine or shades.
//   2. No other hues. Structure comes from ramp position, alpha, and font style.
//   3. Alpha steps follow the palette's own (dark: .78 muted, .14 line; light: .72, .12).
//      Extra steps: .06 hover, .10 active, .22 strong, .38 disabled, .50 faint, .60/.62 hint.
//   4. Alpha hex: .06=0f .10=1a .12=1f .14=24 .15=26 .20=33 .22=38 .25=40 .30=4d
//                 .35=59 .38=61 .40=66 .50=80 .60=99 .62=9e .72=b8 .78=c7
// =============================================================================
{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Vaporsoft",
  "author": "Vaporsoft",
  "themes": [
    // =========================================================================
    // VAPORSOFT DARK  (ground: ink)
    // =========================================================================
    {
