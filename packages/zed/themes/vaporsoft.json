        "conflict.border": "#a11f31",

        // --- Status: created -------------------------------------------------
        "created": "#2ea44f",
        "created.background": "#2ea44f26",
        "created.border": "#2ea44f80",

        // --- Status: deleted -------------------------------------------------
        "deleted": "#c3777e",
        "deleted.background": "#a11f3133",
        "deleted.border": "#a11f31",

        // --- Status: error ---------------------------------------------------
