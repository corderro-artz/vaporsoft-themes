        "terminal.background": "#07080b",
        "terminal.foreground": "#f2ede6",
        "terminal.ansi.background": "#07080b",
        "terminal.bright_foreground": "#f2ede6",
        "terminal.dim_foreground": "#f2ede680",

        // --- Terminal: ANSI (single hue: ramp tiers; green = live signal) ----
        "terminal.ansi.black": "#121318",
        "terminal.ansi.bright_black": "#f2ede680",
        "terminal.ansi.dim_black": "#121318",
        "terminal.ansi.red": "#c3777e",
        "terminal.ansi.bright_red": "#d39ea1",
        "terminal.ansi.dim_red": "#b44f5b",
        "terminal.ansi.green": "#2ea44f",
        "terminal.ansi.bright_green": "#2ea44f",
        "terminal.ansi.dim_green": "#2ea44f",
        "terminal.ansi.yellow": "#e2c6c3",
        "terminal.ansi.bright_yellow": "#f2ede6",
        "terminal.ansi.dim_yellow": "#d39ea1",
        "terminal.ansi.blue": "#b44f5b",
        "terminal.ansi.bright_blue": "#c3777e",
        "terminal.ansi.dim_blue": "#801c2b",
        "terminal.ansi.magenta": "#d39ea1",
        "terminal.ansi.bright_magenta": "#e2c6c3",
        "terminal.ansi.dim_magenta": "#b44f5b",
        "terminal.ansi.cyan": "#f2ede6c7",
        "terminal.ansi.bright_cyan": "#f2ede6",
